# Copy to .env and fill in only the API keys you use.
DNSDUMPSTER_API_KEY=
VIEWDNS_API_KEY=
VT_API_KEY=
SECURITYTRAILS_API_KEY=

# Optional comma-separated keyword substrings to flag in VirusTotal results.
# E.g. if monitoring domains related to an organization you own:
RECON_HIGH_INTEREST_KEYWORDS=
